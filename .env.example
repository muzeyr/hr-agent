# --- Destination configuration for hybrid testing of on-premise destinations --- #
# Copy to `.env` and replace the names with the destinations of your subaccount.
# The proxy is the local end of `cf ssh -L 8887:...` to the connectivity proxy.
destinations='[{"name": "MY_ONPREM_SYSTEM","url": "http://MY_ONPREM_SYSTEM.dest","proxyConfiguration":{"host": "127.0.0.1","port": 8887,"protocol":"http"}}]'
