{
  // Type checking for the tests, kept out of `tsconfig.json` on purpose: the
  // CAP `typescript` build task compiles whatever that file includes into
  // gen/srv, so listing the tests there would ship them to Cloud Foundry.
  // Verified — they turned up as gen/srv/test/unit/*.test.js.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "@cap-js/cds-types"]
  },
  "include": ["srv/**/*.ts", "test/**/*.ts", "@cds-models/**/*.ts", "vitest.config.mts"]
}
